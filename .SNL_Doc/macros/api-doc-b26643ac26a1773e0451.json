{
  "format": "snl-macro",
  "version": 1,
  "package": "api-doc",
  "macro": {
    "name": "api.code",
    "description": "Inline monospace fallback for arbitrary code snippets (e.g. \\forall, `dist-lib/index.js`). No color; use when no other kind fits.",
    "kind": "fvar",
    "dynamic_arity": false,
    "source": {
      "entries": [],
      "urls": []
    },
    "styles": [
      {
        "style_name": "default",
        "tags": [],
        "template": {
          "mode": "formula_inline",
          "body": "\\texttt{#0}"
        }
      }
    ],
    "tags": []
  },
  "schema_version": 1
}
