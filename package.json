{
  "name": "@sjtu-ai4math/snl-basics",
  "version": "0.2.3",
  "license": "MIT",
  "description": "SNL syntax tree → React (KaTeX + htmlData hover) — SNL_Basics",
  "keywords": [
    "structured-natural-language",
    "snl",
    "react",
    "katex",
    "mathematics"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/SJTU-AI4Math/SNL-Basics.git"
  },
  "homepage": "https://github.com/SJTU-AI4Math/SNL-Basics#readme",
  "bugs": {
    "url": "https://github.com/SJTU-AI4Math/SNL-Basics/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "exports": {
    ".": {
      "types": "./dist-lib/index.d.ts",
      "import": "./dist-lib/index.js",
      "default": "./dist-lib/index.js"
    },
    "./runtime": {
      "types": "./dist-lib/runtime.d.ts",
      "import": "./dist-lib/runtime.js",
      "default": "./dist-lib/runtime.js"
    },
    "./core": {
      "types": "./dist-lib/core.d.ts",
      "import": "./dist-lib/core.js",
      "default": "./dist-lib/core.js"
    },
    "./hover": {
      "types": "./dist-lib/hover.d.ts",
      "import": "./dist-lib/hover.js",
      "default": "./dist-lib/hover.js"
    },
    "./entry": {
      "types": "./dist-lib/entry.d.ts",
      "import": "./dist-lib/entry.js",
      "default": "./dist-lib/entry.js"
    },
    "./entry/style.css": {
      "types": "./dist-lib/style-css.d.ts",
      "default": "./dist-lib/entry.css"
    },
    "./style.css": {
      "types": "./dist-lib/style-css.d.ts",
      "default": "./dist-lib/style.css"
    }
  },
  "types": "./dist-lib/index.d.ts",
  "typesVersions": {
    "*": {
      "core": [
        "dist-lib/core.d.ts"
      ],
      "runtime": [
        "dist-lib/runtime.d.ts"
      ],
      "hover": [
        "dist-lib/hover.d.ts"
      ],
      "entry": [
        "dist-lib/entry.d.ts"
      ]
    }
  },
  "files": [
    "dist-lib",
    "README.md",
    "README(ZH).md",
    "MIGRATION.md",
    "LICENSE"
  ],
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "build:lib": "vite build --config vite.lib.config.ts && vite build --config vite.runtime.config.ts && tsc -p tsconfig.entry.json && node scripts/copy-lib-assets.mjs && tsc --noEmit --strict --skipLibCheck false --module NodeNext --moduleResolution NodeNext --target ES2022 scripts/verify-subpath-types.ts && node scripts/verify-subpath-identity.mjs && node scripts/verify-entry-style-closure.mjs",
    "preview": "vite preview",
    "test": "vitest run",
    "verify:packed-entry-i18n": "node scripts/verify-packed-entry-i18n.mjs",
    "prepublishOnly": "npm run build:lib",
    "test:root-text-typography": "node scripts/verify-root-text-typography.mjs",
    "test:popover-origin": "node scripts/verify-popover-origin.mjs"
  },
  "peerDependencies": {
    "katex": "^0.16.0",
    "react": "^18.0.0 || ^19.0.0",
    "react-dom": "^18.0.0 || ^19.0.0"
  },
  "devDependencies": {
    "@testing-library/react": "^16.3.2",
    "@types/node": "^26.1.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.0.0",
    "jsdom": "^29.1.1",
    "katex": "^0.16.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "typescript": "~5.9.3",
    "vite": "^8.0.1",
    "vite-plugin-dts": "^4.5.0",
    "vitest": "^3.2.4"
  },
  "dependencies": {
    "react-markdown": "^10.1.0",
    "rehype-katex": "^7.0.1",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0"
  }
}
