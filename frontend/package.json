{
  "name": "@fulcrum-smarterm/operator-katex",
  "private": true,
  "version": "0.1.0",
  "description": "Operator tree → KaTeX rendering with htmlData hover (Fulcrum Smarterm)",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist-lib/index.d.ts",
      "import": "./dist-lib/index.js",
      "default": "./dist-lib/index.js"
    },
    "./style.css": "./dist-lib/style.css",
    "./katex-template-db.json": "./dist-lib/katex-template-db.json"
  },
  "types": "./dist-lib/index.d.ts",
  "files": [
    "dist-lib"
  ],
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "build:lib": "vite build --config vite.lib.config.ts && node scripts/copy-lib-assets.mjs",
    "preview": "vite preview",
    "test": "vitest run",
    "prepublishOnly": "npm run build:lib"
  },
  "peerDependencies": {
    "katex": "^0.16.0",
    "react": "^18.0.0 || ^19.0.0"
  },
  "devDependencies": {
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.0.0",
    "typescript": "~5.9.3",
    "vite": "^8.0.1",
    "vite-plugin-dts": "^4.5.0",
    "vitest": "^3.2.4"
  },
  "dependencies": {
    "katex": "^0.16.39",
    "react": "^19.2.4",
    "react-dom": "^19.2.4"
  }
}
